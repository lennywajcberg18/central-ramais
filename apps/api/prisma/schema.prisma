generator client {
  provider      = "prisma-client-js"
  // A Vercel roda as funções em Amazon Linux com OpenSSL 3, e o Prisma escolhe o
  // motor de query pelo sistema onde o `generate` rodou. Sem declarar o alvo, o
  // build gera só o binário da máquina que buildou e a função quebra no primeiro
  // acesso ao banco, com "Query engine library for current platform could not be
  // found" — em runtime, não no build.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// `url` e `directUrl` apontam para o MESMO banco por caminhos diferentes, e a
// separação não é preferência: o runtime entra pelo pooler em modo transação
// (porta 6543), que multiplexa conexões e não guarda estado entre um comando e o
// seguinte — exatamente o que uma função serverless precisa, e exatamente o que
// uma migration não pode aceitar, porque `CREATE INDEX` e `ALTER TABLE` dependem
// da mesma sessão do início ao fim. O `directUrl` (porta 5432, modo sessão) é por
// onde o `prisma migrate` passa. Sem ele a migration quebra no meio e deixa o
// schema pela metade.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  agent
}

enum Availability {
  available
  away
  offline
}

enum EntryLinkKind {
  profile
  nominal
}

enum ConversationStatus {
  awaiting_department
  open
  assigned
  awaiting_menu_confirm
  awaiting_feedback
  closed
}

enum CloseReason {
  agent_closed
  timeout
  user_switched
  access_revoked
  no_agent_available
}

enum AccessAttemptReason {
  no_code
  invalid_code
  revoked_link
  nominal_taken
  blocked
}

enum MessageDirection {
  inbound
  outbound
}

// De que LADO da conversa a mensagem veio. Fica gravado no envio porque quem
// escreveu pode atender os dois setores — e porque a conversa é do ramal: a
// colega que entra no plantão seguinte tem que ver as mensagens do setor dela
// do mesmo lado da tela.
enum InternalSide {
  origin
  destination
}

enum InternalThreadStatus {
  open
  closed
}

enum ShiftEndReason {
  manual
  schedule
  admin
}

enum SenderType {
  customer
  agent
  system
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  timezone    String   @default("America/Sao_Paulo")
  csatEnabled Boolean  @default(true) @map("csat_enabled")
  createdAt   DateTime @default(now()) @map("created_at")

  whatsappNumbers  WhatsappNumber[]
  departments      Department[]
  users            User[]
  entryLinks       EntryLink[]
  externalContacts ExternalContact[]
  accessAttempts   AccessAttempt[]
  conversations    Conversation[]
  shifts           Shift[]
  shiftSessions    ShiftSession[]
  coberturas       ShiftSessionDepartment[]
  internalThreads  InternalThread[]
  internalMessages InternalMessage[]

  @@map("tenants")
}

model WhatsappNumber {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  provider    String   @default("twilio")
  // E.164 puro, SEM o prefixo "whatsapp:"
  phoneNumber String   @map("phone_number")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]

  // resolução de tenant pelo campo To do webhook exige unicidade global
  @@unique([phoneNumber])
  @@index([tenantId])
  @@map("whatsapp_numbers")
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  menuKey   String   @map("menu_key")
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  users           UserDepartment[]
  entryLinks      EntryLinkDepartment[]
  conversations   Conversation[]
  shifts          Shift[]
  coberturas      ShiftSessionDepartment[]
  threadsSent     InternalThread[]         @relation("threadFrom")
  threadsReceived InternalThread[]         @relation("threadTo")

  @@unique([tenantId, menuKey])
  @@index([tenantId, active])
  @@map("departments")
}

model User {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  role         Role
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  active       Boolean      @default(true)
  availability Availability @default(offline)
  lastSeenAt   DateTime?    @map("last_seen_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  departments      UserDepartment[]
  conversations    Conversation[]
  shifts           Shift[]
  shiftSessions    ShiftSession[]
  internalThreads  InternalThread[]
  internalMessages InternalMessage[]

  @@index([tenantId])
  @@map("users")
}

// Escala do atendente: uma linha por faixa de plantão em um dia da semana.
// Os minutos são contados desde 00:00 no fuso do tenant; `endMinute` menor que
// `startMinute` significa plantão que vira o dia (19h às 7h).
// A escala é por SETOR, não por pessoa: quem está de plantão está de plantão em
// algum lugar. Sem o setor aqui, entrar de plantão ligava a pessoa em todos os
// setores dela ao mesmo tempo — e aí não há como responder "quantos estão no CT
// agora", que é o que o limite de plantonistas e o aviso de setor descoberto
// precisam saber. Uma pessoa que cobre dois setores no mesmo turno tem duas
// linhas, uma por setor.
model Shift {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  userId       String   @map("user_id")
  departmentId String   @map("department_id")
  weekday      Int
  startMinute  Int      @map("start_minute")
  endMinute    Int      @map("end_minute")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@index([tenantId, userId, weekday])
  @@index([tenantId, departmentId, weekday])
  @@map("shifts")
}

// O plantão que está de fato acontecendo. Nasce no login do atendente e é o que
// sustenta a sessão: sem uma sessão aberta aqui, o token não vale mais nada.
model ShiftSession {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  userId    String          @map("user_id")
  startedAt DateTime        @default(now()) @map("started_at")
  endsAt    DateTime        @map("ends_at")
  endedAt   DateTime?       @map("ended_at")
  endReason ShiftEndReason? @map("end_reason")

  tenant     Tenant                   @relation(fields: [tenantId], references: [id])
  user       User                     @relation(fields: [userId], references: [id])
  coberturas ShiftSessionDepartment[]

  // o job varre por sessões abertas vencidas; o middleware busca a do token
  @@index([tenantId, userId, endedAt])
  @@index([endedAt, endsAt])
  @@map("shift_sessions")
}

// Em quais setores este plantão está de pé, e até quando em cada um.
//
// O plantão continua sendo UM por pessoa — é o que o token carrega, é o que o
// botão "meu plantão acabou" encerra, e é o que o índice parcial de login duplo
// protege. O que muda é que ele deixa de valer para todos os setores da pessoa
// por tabela e passa a valer para os que a escala disser, um a um.
//
// Cada setor tem o seu `endsAt` porque a escala é por setor: quem faz CT das 7h
// às 13h e Recepção das 13h às 19h para de receber do CT ao meio-dia e meia sem
// que o plantão inteiro acabe. Fundir isso numa hora só é o que o relógio do
// projeto faz de propósito (`minutesLeftInShift` cola faixas encostadas, senão a
// escala 00:00–24:00 desloga a pessoa toda meia-noite) — e é justamente o que
// não pode valer entre setores diferentes.
model ShiftSessionDepartment {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  shiftSessionId String    @map("shift_session_id")
  departmentId   String    @map("department_id")
  endsAt         DateTime  @map("ends_at")
  endedAt        DateTime? @map("ended_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  session    ShiftSession @relation(fields: [shiftSessionId], references: [id], onDelete: Cascade)
  department Department   @relation(fields: [departmentId], references: [id])

  // "quem está de plantão neste setor agora" — a consulta do rodízio, da
  // contagem por setor e do aviso de setor descoberto
  @@index([tenantId, departmentId, endedAt])
  @@index([shiftSessionId, endedAt])
  // uma cobertura aberta por (sessão, setor) vive no índice parcial
  // `cobertura_aberta_unica`, na migration — o Prisma não modela índice com WHERE
  @@map("shift_session_departments")
}

model UserDepartment {
  userId       String @map("user_id")
  departmentId String @map("department_id")

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@id([userId, departmentId])
  @@map("user_departments")
}

// Conversa entre dois ramais do hospital. Não tem externo envolvido e não passa
// pelo WhatsApp: é a Enfermagem perguntando ao Faturamento, pela plataforma.
model InternalThread {
  id               String               @id @default(uuid())
  tenantId         String               @map("tenant_id")
  fromDepartmentId String               @map("from_department_id")
  toDepartmentId   String               @map("to_department_id")
  status           InternalThreadStatus @default(open)
  createdByUserId  String               @map("created_by_user_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  lastMessageAt    DateTime             @default(now()) @map("last_message_at")
  closedAt         DateTime?            @map("closed_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  fromDepartment Department        @relation("threadFrom", fields: [fromDepartmentId], references: [id])
  toDepartment   Department        @relation("threadTo", fields: [toDepartmentId], references: [id])
  createdBy      User              @relation(fields: [createdByUserId], references: [id])
  messages       InternalMessage[]

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, fromDepartmentId])
  @@index([tenantId, toDepartmentId])
  @@map("internal_threads")
}

model InternalMessage {
  id         String       @id @default(uuid())
  tenantId   String       @map("tenant_id")
  threadId   String       @map("thread_id")
  userId     String       @map("user_id")
  senderSide InternalSide @map("sender_side")
  body       String
  createdAt  DateTime     @default(now()) @map("created_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  thread InternalThread @relation(fields: [threadId], references: [id])
  user   User           @relation(fields: [userId], references: [id])

  @@index([tenantId, threadId, createdAt])
  @@map("internal_messages")
}

model EntryLink {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  slug            String        @unique
  entryCode       String        @map("entry_code")
  kind            EntryLinkKind
  label           String
  holderNote      String?       @map("holder_note")
  prefillText     String        @map("prefill_text")
  active          Boolean       @default(true)
  revokedAt       DateTime?     @map("revoked_at")
  revokedByUserId String?       @map("revoked_by_user_id")
  useCount        Int           @default(0) @map("use_count")
  createdAt       DateTime      @default(now()) @map("created_at")
  createdByUserId String?       @map("created_by_user_id")

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  departments      EntryLinkDepartment[]
  externalContacts ExternalContact[]
  conversations    Conversation[]

  @@unique([tenantId, entryCode])
  @@index([tenantId])
  @@map("entry_links")
}

model EntryLinkDepartment {
  entryLinkId  String @map("entry_link_id")
  departmentId String @map("department_id")

  entryLink  EntryLink  @relation(fields: [entryLinkId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@id([entryLinkId, departmentId])
  @@map("entry_link_departments")
}

model ExternalContact {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  waNumber    String   @map("wa_number")
  entryLinkId String   @map("entry_link_id")
  blocked     Boolean  @default(false)
  // Contato criado pelo simulador de demonstração. Nada é enviado de verdade
  // para ele — ver a migration 20260818210000_contato_simulado.
  simulated   Boolean  @default(false)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  entryLink     EntryLink      @relation(fields: [entryLinkId], references: [id])
  conversations Conversation[]

  @@unique([tenantId, waNumber])
  @@index([tenantId, entryLinkId])
  @@index([tenantId, waNumber, simulated], map: "external_contacts_simulated_idx")
  @@map("external_contacts")
}

model AccessAttempt {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  waNumber       String              @map("wa_number")
  entryCodeTried String?             @map("entry_code_tried")
  reason         AccessAttemptReason
  createdAt      DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("access_attempts")
}

model Conversation {
  id                     String             @id @default(uuid())
  tenantId               String             @map("tenant_id")
  whatsappNumberId       String             @map("whatsapp_number_id")
  externalContactId      String             @map("external_contact_id")
  departmentId           String?            @map("department_id")
  entryLinkId            String             @map("entry_link_id")
  entryLinkLabelSnapshot String             @map("entry_link_label_snapshot")
  status                 ConversationStatus
  assignedUserId         String?            @map("assigned_user_id")
  closeReason            CloseReason?       @map("close_reason")
  createdAt              DateTime           @default(now()) @map("created_at")
  // assignedAt é a atribuição ATUAL (usada no rodízio) e volta a nulo quando a
  // conversa retorna para a fila; firstAssignedAt é write-once e é o que mede
  // quanto o externo esperou até cair com alguém.
  assignedAt             DateTime?          @map("assigned_at")
  firstAssignedAt        DateTime?          @map("first_assigned_at")
  firstReplyAt           DateTime?          @map("first_reply_at")
  closedAt               DateTime?          @map("closed_at")
  lastMessageAt          DateTime           @default(now()) @map("last_message_at")
  menuRetries            Int                @default(0) @map("menu_retries")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  whatsappNumber  WhatsappNumber  @relation(fields: [whatsappNumberId], references: [id])
  externalContact ExternalContact @relation(fields: [externalContactId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])
  entryLink       EntryLink       @relation(fields: [entryLinkId], references: [id])
  assignedUser    User?           @relation(fields: [assignedUserId], references: [id])
  messages        Message[]
  feedback        Feedback?

  @@index([tenantId, externalContactId, status])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, entryLinkId])
  @@index([tenantId, createdAt])
  // O rodízio pergunta "quando cada atendente recebeu a última conversa" a cada
  // atribuição, dentro da fila serializada do setor: sem este índice é Seq Scan
  // na tabela inteira e o ramal para de distribuir enquanto varre.
  @@index([tenantId, assignedUserId, assignedAt])
  // A lista do gestor com `situacao=todas` não filtra status, então o índice
  // acima com status não serve para o ORDER BY last_message_at.
  @@index([tenantId, lastMessageAt])
  // Existe ainda um índice único PARCIAL em (tenant_id, external_contact_id)
  // restrito aos status ativos — "uma conversa aberta por contato". O Prisma não
  // modela índice parcial, então ele vive só no SQL da migration
  // 20260817170100_conversa_ativa_unica e aparece como drift no `migrate dev`.
  // Não o remova do banco: sem ele dois processos abrem duas conversas para o
  // mesmo número e o contato recebe dois menus.
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  senderType     SenderType       @map("sender_type")
  body           String
  waMessageId    String?          @map("wa_message_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  // dedupe de reentrega do Twilio
  @@unique([waMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Feedback {
  id             String   @id @default(uuid())
  conversationId String   @unique @map("conversation_id")
  score          Int?
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@map("feedback")
}
