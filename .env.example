# Copie para apps/api/.env

# Por onde a APLICAÇÃO fala com o banco. No docker-compose local é o Postgres
# direto; no Supabase é o pooler em modo transação (porta 6543), e aí o
# `?pgbouncer=true` não é opcional: sem ele o Prisma prepara statements que o
# pooler não consegue reencontrar na conexão seguinte, e a API começa a devolver
# "prepared statement s0 already exists" de forma intermitente.
DATABASE_URL="postgresql://central:central@localhost:5432/central_ramais"

# Por onde as MIGRATIONS falam com o banco. Localmente é a mesma coisa; no
# Supabase é o pooler em modo sessão (porta 5432), que segura a mesma conexão do
# início ao fim — requisito de `CREATE INDEX` e `ALTER TABLE`. Precisa existir em
# todo ambiente que roda `prisma migrate deploy`, inclusive o de produção.
DIRECT_URL="postgresql://central:central@localhost:5432/central_ramais"

# O boot recusa subir se as duas URLs acima apontarem para SERVIDORES diferentes:
# seria migration num banco e aplicação em outro, os dois funcionando, sem erro
# para denunciar. Só ligue isto se a divergência for intencional — o caso legítimo
# é ter IPv6 de verdade e usar a conexão direta (db.<ref>.supabase.co) apenas para
# as migrations, deixando a aplicação no pooler.
ALLOW_SPLIT_DB_HOSTS=false

# Porta da API
PORT=3001

# Segredo do agendador. Em serverless não há processo vivo entre requisições, e
# as varreduras (inatividade, fim de plantão) viram POST /jobs/timeout e
# POST /jobs/shift. Endpoint que varre o banco inteiro, sem segredo, é uma forma
# gratuita de derrubar o banco. Mínimo 24 caracteres, e sem valor de fábrica:
# padrão publicado em repositório público não é segredo.
#   openssl rand -base64 36
CRON_SECRET=

# Segredo do JWT (mínimo 16 caracteres). Fica vazio de propósito: este arquivo é
# versionado num repositório público, então qualquer valor aqui é uma chave de
# assinatura que a internet inteira lê. Gere o seu: openssl rand -base64 32
JWT_SECRET=

# Provider de WhatsApp: "mock" (dev, loga no console) ou "twilio"
WHATSAPP_PROVIDER=mock

# Credenciais Twilio — só necessárias com WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Validação de assinatura do webhook Twilio. Com WHATSAPP_PROVIDER=twilio o boot
# exige "true" — sem ela o webhook aceita mensagem forjada de qualquer origem.
TWILIO_VALIDATE_WEBHOOK=false

# Libera o seed de demonstração do startCommand do Render (scripts/seed-if-empty.ts),
# que cria administradores de senha fraca. Só a instância de demonstração usa "true".
ALLOW_DEMO_SEED=false

# Base pública da API (usada no QR code e no webhook URL)
PUBLIC_BASE_URL=http://localhost:3001

# Origem do frontend, para CORS
WEB_ORIGIN=http://localhost:3000
