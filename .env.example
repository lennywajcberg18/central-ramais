# Copie para apps/api/.env

# Postgres do docker-compose.yml
DATABASE_URL="postgresql://central:central@localhost:5432/central_ramais"

# Porta da API
PORT=3001

# Segredo do JWT (troque em produção; mínimo 16 caracteres)
JWT_SECRET="dev-secret-troque-em-producao"

# Provider de WhatsApp: "mock" (dev, loga no console) ou "twilio"
WHATSAPP_PROVIDER=mock

# Credenciais Twilio — só necessárias com WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Validação de assinatura do webhook Twilio ("true" em produção)
TWILIO_VALIDATE_WEBHOOK=false

# Base pública da API (usada no QR code e no webhook URL)
PUBLIC_BASE_URL=http://localhost:3001

# Origem do frontend, para CORS
WEB_ORIGIN=http://localhost:3000
